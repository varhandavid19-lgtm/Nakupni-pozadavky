// ==========================================================
//  PRAVIDLA PRO MODUL ENGINEERING (prostoje ze Symesticu)
// ==========================================================
//
//  POZOR: tohle NENÍ celý soubor pravidel — je to jen kousek, který se má
//  PŘIDAT do tvých stávajících pravidel ve Firebase konzoli.
//
//  Postup (dělá se ručně, do konzole nevidím):
//    1) Firebase konzole → Firestore Database → záložka Rules
//    2) najdi řádek "match /databases/{database}/documents {"
//    3) hned pod něj vlož obě funkce (signedIn, isEngAdmin) a všechny tři bloky
//       "match /downtimes", "match /dt_days" a "match /dt_imports" z tohoto souboru
//    4) Publish
//
//  Dokud se pravidla nepublikují, modul Engineering hlásí, že do prostojů nevidí.
//  Nic jiného se nerozbije — na nákupní požadavky tahle pravidla nesahají.
// ==========================================================

    // --- pomocné funkce (pokud už podobné máš, nepřidávej je podruhé) ---
    function signedIn() {
      return request.auth != null;
    }
    function isEngAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- jednotlivé prostoje (jeden dokument = jeden prostoj ze Symesticu) ---
    // Čte každý přihlášený, zapisuje jen administrátor při importu.
    match /downtimes/{id} {
      allow read:  if signedIn();
      allow write: if isEngAdmin();
    }

    // --- denní souhrny, ze kterých se kreslí přehled a KPI ---
    match /dt_days/{date} {
      allow read:  if signedIn();
      allow write: if isEngAdmin();
    }

    // --- historie importů (kdo, kdy, jaký soubor) ---
    // Záznam o importu jde jen založit, ne měnit ani mazat — je to stopa v historii.
    match /dt_imports/{id} {
      allow read:   if signedIn();
      allow create: if isEngAdmin();
      allow update, delete: if false;
    }
